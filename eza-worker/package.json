{
  "name": "vibe-lifestyle-worker",
  "version": "2.0.0",
  "description": "Vibe Lifestyle Telegram Mini App API on Cloudflare Workers with Hono.js and Neon PostgreSQL",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:prod": "wrangler deploy --env production",
    "test": "vitest",
    "type-check": "tsc --noEmit",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.5",
    "@tsndr/cloudflare-worker-jwt": "^2.5.0",
    "bakong-khqr": "^1.0.20",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.32.0",
    "hono": "^4.5.0",
    "nanoid": "^5.0.0",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240815.0",
    "@types/bcryptjs": "^2.4.6",
    "drizzle-kit": "^0.23.0",
    "pg": "^8.23.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "wrangler": "^3.70.0"
  }
}
